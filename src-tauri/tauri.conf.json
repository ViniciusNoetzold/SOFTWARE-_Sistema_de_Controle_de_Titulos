{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MezzoldTitulos",
  "version": "1.0.5",
  "identifier": "com.mezzold.titulos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mezzold Titulos",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../Bin/Firebird-2.5.9.27139_0_Win32.exe",
      "../Bin/Firebird-2.5.9.27139_0_x64.exe",
      "../Bin/IBExpert.exe",
      "../Bin/IBEScript.exe",
      "../schema_firebird.sql",
      "../install_mezzold_environment.bat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
